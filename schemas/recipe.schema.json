{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytrainx.fit/schemas/recipe.schema.json",
  "title": "MyTrainX Recipe",
  "type": "object",
  "required": [
    "slug",
    "title",
    "language",
    "ingredients",
    "steps",
    "access_policy",
    "ai_index_policy",
    "status"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "pt-BR",
        "pt-PT",
        "en",
        "es"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "meal_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "servings": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "prep_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cook_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "food_source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "preparation": {
            "type": [
              "string",
              "null"
            ]
          },
          "optional": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "nutrition": {
      "type": [
        "object",
        "null"
      ],
      "description": "Populate only from a traceable verified source or calculation pipeline."
    },
    "access_policy": {
      "enum": [
        "public",
        "registered",
        "owned_product",
        "master",
        "staff_only"
      ]
    },
    "ai_index_policy": {
      "enum": [
        "none",
        "metadata_only",
        "retrievable"
      ]
    },
    "status": {
      "enum": [
        "inventory",
        "needs_ingestion",
        "indexed",
        "published",
        "archived"
      ]
    },
    "source": {
      "type": [
        "object",
        "null"
      ]
    },
    "rights_status": {
      "enum": [
        "unverified",
        "pending",
        "verified",
        "restricted",
        "expired",
        "disputed"
      ]
    },
    "review_flags": {
      "type": "array",
      "items": {
        "enum": [
          "editorial",
          "scientific",
          "legal",
          "safety",
          "nutrition"
        ]
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
