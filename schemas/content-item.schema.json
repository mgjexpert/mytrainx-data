{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytrainx.fit/schemas/content-item.schema.json",
  "title": "MyTrainX Content Item",
  "type": "object",
  "required": [
    "slug",
    "title",
    "content_type",
    "language",
    "source",
    "access_policy",
    "ai_index_policy",
    "status"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_type": {
      "enum": [
        "workout_video",
        "educational_video",
        "ebook_pdf",
        "manual",
        "recipe",
        "article",
        "checklist",
        "program_material",
        "event_live",
        "audio",
        "image"
      ]
    },
    "language": {
      "enum": [
        "pt-BR",
        "pt-PT",
        "en",
        "es"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "difficulty": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "all_levels",
        null
      ]
    },
    "estimated_duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "reading_time_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "downloadable": {
      "type": "boolean"
    },
    "featured": {
      "type": "boolean"
    },
    "sort_priority": {
      "type": "integer"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "google_drive",
            "upload",
            "external",
            "generated",
            "github",
            "owned_media",
            "usda_fdc",
            "open_food_facts",
            "who",
            "nhs",
            "gov_br"
          ]
        },
        "collection_slug": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "checksum_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "thumbnail_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "access_policy": {
      "enum": [
        "public",
        "registered",
        "owned_product",
        "master",
        "staff_only"
      ]
    },
    "ai_index_policy": {
      "enum": [
        "none",
        "metadata_only",
        "retrievable"
      ]
    },
    "product_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rights_status": {
      "enum": [
        "unverified",
        "pending",
        "verified",
        "restricted",
        "expired",
        "disputed"
      ]
    },
    "review_flags": {
      "type": "array",
      "items": {
        "enum": [
          "editorial",
          "scientific",
          "legal",
          "safety",
          "nutrition",
          "exercise"
        ]
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "inventory",
        "needs_ingestion",
        "indexed",
        "published",
        "archived"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
