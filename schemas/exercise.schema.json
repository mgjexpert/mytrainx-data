{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytrainx.fit/schemas/exercise.schema.json",
  "title": "MyTrainX Exercise",
  "type": "object",
  "required": [
    "slug",
    "name",
    "locale",
    "exercise_type",
    "difficulty",
    "status",
    "review_status"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "canonical_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "locale": {
      "enum": [
        "pt-BR",
        "pt-PT",
        "en",
        "es"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "exercise_type": {
      "enum": [
        "strength",
        "conditioning",
        "mobility",
        "flexibility",
        "balance",
        "skill",
        "warmup",
        "recovery",
        "other"
      ]
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "all_levels"
      ]
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "primary_muscles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "secondary_muscles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "movement_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "body_regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coaching_cues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": [
        "object",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "pending",
        "approved",
        "changes_required"
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
